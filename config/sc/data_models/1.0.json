	"data_model_version": "1.0",
	"tables": {
		"contribution": {
			"label": "Contribution",
			"position": 1,
			"description": "Contribution metadata",
			"notes": "One contribution per legacy catalog region (a seamount trail, chain or ocean basin).",
			"columns": {
				"id": {
					"label": "Contribution ID",
					"group": "Contribution",
					"position": 1,
					"type": "Integer",
					"description": "Unique SC Contribution ID",
					"notes": "Written during contribution activation",
					"examples": [
						"1"
					],
					"validations": [
						"downloadOnly()"
					]
				},
				"version": {
					"label": "Version",
					"group": "Contribution",
					"position": 2,
					"type": "Integer",
					"description": "Contribution version number",
					"notes": "1 for the original contribution, empty if the contribution is not activated",
					"validations": [
						"downloadOnly()"
					]
				},
				"timestamp": {
					"label": "Activation Timestamp",
					"group": "Contribution",
					"position": 3,
					"type": "Timestamp",
					"description": "Date and time of contribution activation",
					"notes": "ISO 8601 date and time (e.g. \"yyyy-mm-ddThh:mm:ss.sssZ\")",
					"examples": [
						"2026-09-30T19:03:00Z"
					],
					"validations": [
						"downloadOnly()"
					]
				},
				"contributor": {
					"label": "Contributor",
					"group": "Contribution",
					"position": 4,
					"type": "String",
					"description": "Contributor EarthRef handle",
					"notes": "Written during contribution activation",
					"examples": [
						"@akoppers"
					],
					"validations": [
						"downloadOnly()"
					]
				},
				"is_validated": {
					"label": "Is Validated",
					"group": "Contribution",
					"position": 5,
					"type": "String",
					"description": "Contribution has passed the SC Data Model validation",
					"unit": "Flag",
					"validations": [
						"cv(\"boolean\")",
						"downloadOnly()"
					]
				},
				"is_reviewed": {
					"label": "Is Reviewed",
					"group": "Contribution",
					"position": 6,
					"type": "String",
					"description": "Contribution has been reviewed for correct usage of the SC Data Model",
					"unit": "Flag",
					"validations": [
						"cv(\"boolean\")",
						"downloadOnly()"
					]
				},
				"data_model_version": {
					"label": "Data Model Version",
					"group": "Contribution",
					"position": 7,
					"type": "String",
					"description": "SC data model version",
					"examples": [
						"1.0"
					],
					"validations": [
						"cv(\"sc_version\")",
						"downloadOnly()"
					]
				},
				"reference": {
					"label": "Contribution Reference",
					"group": "Contribution",
					"position": 8,
					"type": "String",
					"description": "DOI or citation of the publication this contribution supports",
					"examples": [
						"10.1029/2003GC000609"
					],
					"validations": [
						"recommended()"
					]
				},
				"author": {
					"label": "Contribution Author",
					"group": "Contribution",
					"position": 9,
					"type": "String",
					"description": "EarthRef handle, ORCID, or name and email of the author of the contribution",
