				},
				"description": {
					"label": "Description",
					"group": "Contribution",
					"position": 10,
					"type": "String",
					"description": "Description of the contribution as a whole",
					"validations": [
						"recommended()"
					]
				},
				"supplemental_links": {
					"label": "Supplemental Links",
					"group": "Contribution",
					"position": 11,
					"type": "Dictionary",
