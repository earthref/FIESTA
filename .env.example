# Which FIESTA node(s) this stack serves — comma-separated list of
# magic | kdd | cdr | karar | erda | osu-mgr. One API (/v2/{node}/...), one
# worker and one frontend (http://localhost:8080/MagIC/, /KArAr/, ...) serve
# every listed node; infrastructure (Postgres/OpenSearch/RustFS/Mailpit) is
# shared. The portal bar links listed nodes locally, the rest to earthref.org.
# `make` targets also honor FIESTA_NODE overrides on the command line.
#   FIESTA_NODE=magic
#   FIESTA_NODE=magic,karar,cdr
FIESTA_NODE=magic

# Infrastructure secrets (change for anything beyond local dev).
POSTGRES_PASSWORD=fiesta
RUSTFS_ACCESS_KEY=fiesta
RUSTFS_SECRET_KEY=fiesta-secret
FIESTA_SECRET_KEY=dev-only-change-me

# Published host ports (override if something else is already listening).
POSTGRES_PORT=5432
OPENSEARCH_PORT=9200
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
MAILPIT_WEB_PORT=8025
API_PORT=8000
FRONTEND_PORT=8080

# Use a distinct project and ports when running another checkout alongside this one.
#COMPOSE_PROJECT_NAME=fiesta-my-worktree
