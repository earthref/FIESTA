# Which FIESTA node(s) this stack serves — comma-separated list of
# magic | kdd | cdr | karar | erda | osu-mgr. One API (/v2/{node}/...) and one
# worker serve every listed node; each node gets its own frontend;
# infrastructure (Postgres/OpenSearch/MinIO/Mailpit) is shared.
#   FIESTA_NODE=magic
#   FIESTA_NODE=magic,karar,cdr
FIESTA_NODE=magic
# docker compose activates the frontends via profiles; keep this mirroring
# FIESTA_NODE (interpolated automatically). `make` targets also honor
# FIESTA_NODE overrides on the command line.
COMPOSE_PROFILES=${FIESTA_NODE}

# Infrastructure secrets (change for anything beyond local dev).
POSTGRES_PASSWORD=fiesta
MINIO_ROOT_USER=fiesta
MINIO_ROOT_PASSWORD=fiesta-secret
FIESTA_SECRET_KEY=dev-only-change-me

# Published host ports (override if something else is already listening).
POSTGRES_PORT=5432
OPENSEARCH_PORT=9200
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_WEB_PORT=8025
API_PORT=8000
MAGIC_FRONTEND_PORT=8080
KDD_FRONTEND_PORT=8081
CDR_FRONTEND_PORT=8082
KARAR_FRONTEND_PORT=8083
ERDA_FRONTEND_PORT=8084
OSU_MGR_FRONTEND_PORT=8086

# Base path per node when several nodes share ONE hostname behind a reverse
# proxy (dev.earthref.org/MagIC/, /CDR/, ...). Must start and end with "/".
# Baked into the frontend image at build time (rebuild after changing). Leave
# unset for "/" (each node on its own hostname / localhost port).
#MAGIC_BASE_PATH=/MagIC/
#KDD_BASE_PATH=/KdD/
#CDR_BASE_PATH=/CDR/
#KARAR_BASE_PATH=/KArAr/
#ERDA_BASE_PATH=/ERDA/
#OSU_MGR_BASE_PATH=/OSU-MGR/

# Use a distinct project and ports when running another checkout alongside this one.
#COMPOSE_PROJECT_NAME=fiesta-my-worktree
