# Rendered by the nginx image's envsubst entrypoint. Only ${BACKEND_HOST},
# ${BASE_PATH}, ${FIESTA_NODE}, ${FIESTA_NODES} and ${API_URL} are substituted
# (they are the defined env vars); nginx's own $uri/$host variables pass
# through untouched.
#
# BASE_PATH is "/" or a node prefix like "/MagIC/" (leading + trailing slash),
# so the locations render as /v2/, /assets/, / -- or /MagIC/v2/,
# /MagIC/assets/, /MagIC/. The build is installed at <root><BASE_PATH>, which
# is why the static locations need no alias. A request for the bare prefix
# without its slash (/MagIC) hits no location and nginx's directory handling
# redirects it to /MagIC/.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Runtime SPA settings: which node this frontend is for (or, with
    # FIESTA_NODES, the list of nodes served under ${BASE_PATH}<node>/) and
    # where the API is (empty = same origin, proxied below). Overrides the copy
    # `vite build` put in dist, so one image serves any node or every node.
    location = ${BASE_PATH}fiesta-env.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache";
        return 200 'window.__FIESTA__={"node":"${FIESTA_NODE}","apiUrl":"${API_URL}","nodes":"${FIESTA_NODES}"};';
    }

    # The build id the update poller compares against the one in the running
    # bundle (src/lib/use-update-available.ts): never cached.
    location = ${BASE_PATH}version.json {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    # Proxy API requests to the FIESTA API service. The URI part on proxy_pass
    # replaces the matched prefix, so the API always sees /v2/ whatever
    # BASE_PATH is.
    location ${BASE_PATH}v2/ {
        proxy_pass http://${BACKEND_HOST}:8000/v2/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The SPA's base path: the API names its own public URLs under it
        # (downloads in JSON-LD, llms.txt; fiesta.apps.public_urls).
        proxy_set_header X-Forwarded-Prefix ${BASE_PATH};
        client_max_body_size 512m;
        proxy_read_timeout 300s;
    }

    # The page head and body the shell's SSI includes ask for (index.html,
    # fiesta.apps.routers.seo): short timeouts, so a slow or stopped API
    # costs the page its crawler text (the include's stub), never its load.
    location ${BASE_PATH}v2/seo/ {
        proxy_pass http://${BACKEND_HOST}:8000/v2/seo/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix ${BASE_PATH};
        # Plain text only: SSI splices the bytes as they come, and the API
        # gzips for a client (the browser's Accept-Encoding) that accepts it.
        proxy_set_header Accept-Encoding "";
        proxy_connect_timeout 1s;
        proxy_read_timeout 5s;
    }

    # What crawlers fetch by name: /robots.txt and /llms.txt for the host,
    # /<Key>/sitemap.xml and /<Key>/llms.txt per node, all from the API.
    location = /robots.txt {
        proxy_pass http://${BACKEND_HOST}:8000/v2/robots.txt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix ${BASE_PATH};
    }
    location = /llms.txt {
        proxy_pass http://${BACKEND_HOST}:8000/v2/llms.txt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix ${BASE_PATH};
    }
    location ~ ^/([^/]+)/(sitemap\.xml|llms\.txt)$ {
        rewrite ^/([^/]+)/(.+)$ /v2/$1/$2 break;
        proxy_pass http://${BACKEND_HOST}:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix ${BASE_PATH};
    }

    # Hashed build assets are safe to cache forever.
    location ${BASE_PATH}assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA history fallback: every other path under the base serves the app shell.
    # The shell names the current hashed chunks, so browsers must revalidate it
    # (no heuristic caching from Last-Modified) or a stale copy points at chunks
    # a deploy removed.
    # `ssi on`: the shell includes the page's head and body for crawlers from
    # the API (index.html; the includes' stubs stand in when it fails).
    location ${BASE_PATH} {
        add_header Cache-Control "no-cache";
        ssi on;
        try_files $uri $uri/ ${BASE_PATH}index.html;
    }
}
