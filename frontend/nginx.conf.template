# Rendered by the nginx image's envsubst entrypoint. Only ${BACKEND_HOST},
# ${BASE_PATH}, ${FIESTA_NODE} and ${API_URL} are substituted (they are the
# defined env vars); nginx's own $uri/$host variables pass through untouched.
#
# BASE_PATH is "/" or a node prefix like "/MagIC/" (leading + trailing slash),
# so the locations render as /v1/, /assets/, / -- or /MagIC/v1/,
# /MagIC/assets/, /MagIC/. The build is installed at <root><BASE_PATH>, which
# is why the static locations need no alias. A request for the bare prefix
# without its slash (/MagIC) hits no location and nginx's directory handling
# redirects it to /MagIC/.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Runtime SPA settings: which node this frontend is for and where the API
    # is (empty = same origin, proxied below). Overrides the copy `vite build`
    # put in dist, so one image serves any node.
    location = ${BASE_PATH}fiesta-env.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache";
        return 200 'window.__FIESTA__={"node":"${FIESTA_NODE}","apiUrl":"${API_URL}"};';
    }

    # Proxy API requests to the FIESTA API service. The URI part on proxy_pass
    # replaces the matched prefix, so the API always sees /v1/ whatever
    # BASE_PATH is.
    location ${BASE_PATH}v1/ {
        proxy_pass http://${BACKEND_HOST}:8000/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 512m;
        proxy_read_timeout 300s;
    }

    # Hashed build assets are safe to cache forever.
    location ${BASE_PATH}assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA history fallback: every other path under the base serves the app shell.
    location ${BASE_PATH} {
        try_files $uri $uri/ ${BASE_PATH}index.html;
    }
}
